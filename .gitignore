# OpenClaw Workspace — Ignore sensitive files

# Credentials & Secrets
credentials.json
ig_settings.json
*.auth.json

# Session state (large, sensitive)
ig_playwright_state.json
ig_playwright_state_fb_info.json
.ig_state_backup.json

# Browser profile (massive, auto-generated)
ig_profile/

# Fallback tokens (sensitive)
.session_tokens_fallback.json
.session_tokens_compact.json

# Debug screenshots
*.png
*.jpg
*.jpeg
*.gif
*.mp4

# Instagram images and designs
instagram_images_v2/
instagram_images_v3/
tip_tuesday/

# Session files
ig_session.json
ig_session_saved.json
ig_storage.json
ig_cookies.json

# OS files
.DS_Store
._*
Thumbs.db

# Fred's secrets directory
fred/secrets/

# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
package-lock.json

# Backup key (contains phrase used to encrypt sessions)
.backup_key.json

# Personal memory files (not for GitHub)
memory/*.md
memory/.dreams/

# Local backup snapshots (too large for git, stored locally)
fred/backups/

# Logs
*.log
tmp/

# WhatsApp AI conversations (auto-generated, persists context)
fred/whatsapp-server/ai-conversations.json

# Digital product PDFs (generated from .md source)
fred/products/*.pdf

# NG Kerk mirror (re-downloadable)
fred/ngkerk/site/
